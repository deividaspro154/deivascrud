<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin</title><link rel="stylesheet" href="/style.css"></head><body>
<nav class="nav"><div class="container nav-inner"><a class="brand" href="/">DEIVAS<span>KEYS</span></a><div class="nav-links"><a href="/">Store</a><a class="active" href="/admin">Admin</a><a href="/system">System</a></div></div></nav>
<main class="container page"><h1 style="font-size:46px">Admin CRUD</h1><% if(message){ %><div class="notice ok"><%= message %></div><% } %><% if(error){ %><div class="notice error"><%= error %></div><% } %>
<section class="panel"><h2><%= editProduct?'Update':'Create' %> keyboard</h2><form action="<%= editProduct?'/update/'+editProduct.id:'/create' %>" method="post" enctype="multipart/form-data"><div class="grid"><label>Name · String<input name="name" required value="<%= editProduct?.name??'' %>"></label><label>Quantity · Integer<input name="quantity" type="number" min="0" step="1" required value="<%= editProduct?.quantity??0 %>"></label><label>Price · Decimal<input name="price" type="number" min="0" step="0.01" required value="<%= editProduct?.price??'0.00' %>"></label><label>Restock date · Date<input name="restock_date" type="date" value="<%= editProduct?.restock_date?new Date(editProduct.restock_date).toISOString().slice(0,10):'' %>"></label><label>Image · Railway Volume<input name="image" type="file" accept="image/*"></label><label>Available · Boolean <input name="available" type="checkbox" <%= !editProduct||editProduct.available?'checked':'' %>></label></div><p class="actions"><button type="submit"><%= editProduct?'Save':'Create' %></button><% if(editProduct){ %><a class="button secondary" href="/admin">Cancel</a><% } %></p></form></section>
<section class="panel"><h2>List</h2><div style="overflow:auto"><table><thead><tr><th>Image</th><th>ID</th><th>Name</th><th>Qty</th><th>Price</th><th>Available</th><th>Actions</th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><% if(p.image_url){ %><img class="thumb" src="<%= p.image_url %>"><% } %></td><td><%= p.id %></td><td><%= p.name %></td><td><%= p.quantity %></td><td>€<%= Number(p.price).toFixed(2) %></td><td><%= p.available?'Yes':'No' %></td><td><div class="actions"><a class="button secondary" href="/admin?edit=<%= p.id %>">Edit</a><form action="/delete/<%= p.id %>" method="post"><button class="danger">Delete</button></form></div></td></tr><% }) %></tbody></table></div></section></main></body></html>

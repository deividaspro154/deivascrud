<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>System</title><link rel="stylesheet" href="/style.css"></head><body>
<nav class="nav"><div class="container nav-inner"><a class="brand" href="/">DEIVAS<span>KEYS</span></a><div class="nav-links"><a href="/">Store</a><a href="/admin">Admin</a><a class="active" href="/system">System</a></div></div></nav>
<main class="container page"><h1 style="font-size:46px">Railway System</h1><% if(message){ %><div class="notice ok"><%= message %></div><% } %>
<div class="system-grid"><div class="system-card"><div class="small">Database</div><h2><%= dbInfo.database_name %></h2><p class="small">Railway PostgreSQL</p></div><div class="system-card"><div class="small">File storage</div><h2>Railway Volume</h2><p class="small"><%= uploadDir %></p></div><div class="system-card"><div class="small">Background</div><h2>Railway Cron</h2><p class="small">npm run background</p></div></div>
<section class="panel"><h2>Database proof</h2><p>Actual DB name: <strong><%= dbInfo.database_name %></strong></p><p>DB user: <%= dbInfo.database_user %></p><p>Products: <%= productCount %></p><span class="code">const pool = new Pool({ connectionString: process.env.DATABASE_URL });\npool.query("INSERT INTO products ...")</span></section>
<section class="panel"><h2>Persistent files</h2><p>Volume: <%= volumeName %></p><p>Real mount path: <strong><%= uploadDir %></strong></p><table><thead><tr><th>File</th><th>Size</th><th>Open</th></tr></thead><tbody><% files.forEach(f=>{ %><tr><td><%= f.name %></td><td><%= f.size %></td><td><a href="<%= f.url %>" target="_blank">open</a></td></tr><% }) %></tbody></table><span class="code">await fs.writeFile(path.join(uploadDir, filename), file.buffer);</span></section>
<section class="panel"><h2>Background task</h2><p>Automatic Railway Cron uses separate service with Start Command <code>npm run background</code>.</p><form action="/run-background" method="post"><button>Run same task now for demo</button></form><table><thead><tr><th>Time</th><th>Source</th><th>Changed</th></tr></thead><tbody><% runs.forEach(r=>{ %><tr><td><%= new Date(r.ran_at).toLocaleString() %></td><td><%= r.source %></td><td><%= r.changed_count %></td></tr><% }) %></tbody></table></section>
<section class="panel"><h2>API</h2><span class="code">GET /api/products\nPOST /api/products\nPUT/PATCH /api/products/:id\nDELETE /api/products/:id\nGET /api/storage\nGET /api/status</span></section>
</main></body></html>

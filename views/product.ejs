<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= product.name %></title><link rel="stylesheet" href="/style.css"></head><body>
<nav class="nav"><div class="container nav-inner"><a class="brand" href="/">DEIVAS<span>KEYS</span></a><div class="nav-links"><a href="/">Store</a><a href="/admin">Admin</a><a href="/system">System</a></div></div></nav>
<main class="container page"><a href="/">← Back</a><div class="panel" style="margin-top:20px"><% if(product.image_url){ %><img src="<%= product.image_url %>" style="max-width:100%;max-height:450px;border-radius:12px"><% } %><h1 style="font-size:48px"><%= product.name %></h1><p class="price" style="font-size:30px">€<%= Number(product.price).toFixed(2) %></p><p>Quantity: <%= product.quantity %></p><p>Available: <%= product.available?'Yes':'No' %></p><p>Restock: <%= product.restock_date?new Date(product.restock_date).toISOString().slice(0,10):'Not set' %></p></div></main></body></html>

<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>DeivasKeys Railway</title><link rel="stylesheet" href="/style.css"></head><body>
<nav class="nav"><div class="container nav-inner"><a class="brand" href="/">DEIVAS<span>KEYS</span></a><div class="nav-links"><a class="active" href="/">Store</a><a href="/admin">Admin</a><a href="/system">System</a></div></div></nav>
<main class="container"><section class="hero"><div><div class="eyebrow">Migrated to Railway</div><h1>SAME APP.<br>NEW PAAS.</h1><p>Task 3 keyboard store migrated from Vercel to Railway with the same data and functionality.</p></div><div class="hero-box"><div class="hero-stat"><span>PaaS</span><strong>Railway</strong></div><div class="hero-stat"><span>DB</span><strong>Railway PostgreSQL</strong></div><div class="hero-stat"><span>Files</span><strong>Railway Volume</strong></div><div class="hero-stat"><span>Background</span><strong>Railway Cron</strong></div></div></section>
<h2>Keyboards</h2><div class="products"><% products.forEach(p=>{ %><a class="card" href="/product/<%= p.id %>"><div class="product-image"><% if(p.image_url){ %><img src="<%= p.image_url %>"><% }else{ %>⌨<% } %></div><div class="product-body"><strong><%= p.name %></strong><p class="price">€<%= Number(p.price).toFixed(2) %></p><p class="small">Stock: <%= p.quantity %></p><span class="badge <%= p.available&&p.quantity>0?'in':'out' %>"><%= p.available&&p.quantity>0?'IN STOCK':'OUT OF STOCK' %></span></div></a><% }) %></div></main></body></html>
